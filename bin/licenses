#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
# The licence check . `bin/licenses check` refuses a licence that is
# not free and a stale browser notices file; `bin/licenses stamp` records that
# the notices were reviewed for the locked browser packages.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --locked --quiet python -m tools.licenses "$@"
