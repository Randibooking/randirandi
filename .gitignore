# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
node_modules/

# Gathered when the image is built
/staticfiles/

# Secrets never live in a file here. These names are refused on purpose.
.env
.env.*
*.pem
*.key

.DS_Store

# OpenTofu's encrypted local records and downloaded providers. The provider
# lock file is tracked. No state, saved plan, crash dump or override is.
.terraform/
.local/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Rebuilt from the locked frontend source.
/randirandi/core/static/core/ui/
/randirandi/release.json

/local-ca.crt
